{
  "name": "learn-anything",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first knowledge map and adaptive mastery-path system.",
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @learn-anything/web build",
    "check": "tsc -p tsconfig.json --pretty false",
    "dev": "pnpm --filter @learn-anything/web dev",
    "e2e": "playwright test",
    "test": "node scripts/validate-foundation.mjs && vitest run",
    "validate": "pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.2.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
