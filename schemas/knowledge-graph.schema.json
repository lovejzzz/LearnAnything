{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnanything.dev/schemas/knowledge-graph.schema.json",
  "title": "LearnAnything Knowledge Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "description", "language", "nodes", "edges", "sources"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "license": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "summary", "depth", "estimatedHours", "sourceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": ["concept", "capability", "resource", "experience", "mastery-check", "milestone"]
        },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "depth": {
          "enum": ["orientation", "foundation", "working", "advanced"]
        },
        "estimatedHours": { "type": "number", "minimum": 0 },
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "format", "access"],
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "format": { "enum": ["article", "book", "documentation", "video", "simulation", "course", "tool", "other"] },
            "access": { "enum": ["free", "freemium", "paid", "unknown"] },
            "durationMinutes": { "type": "number", "minimum": 0 }
          }
        },
        "mastery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidenceType", "instructions", "evaluation"],
          "properties": {
            "evidenceType": { "enum": ["explanation", "solution", "analysis", "build", "performance", "project", "reflection"] },
            "instructions": { "type": "string", "minLength": 1 },
            "evaluation": { "enum": ["self", "deterministic", "peer", "expert", "optional-ai"] },
            "diagnostic": {
              "type": "object",
              "additionalProperties": false,
              "required": ["questions", "passingScore"],
              "properties": {
                "questions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "prompt", "options", "correctOptionId"],
                    "properties": {
                      "id": { "$ref": "#/$defs/id" },
                      "prompt": { "type": "string", "minLength": 1 },
                      "options": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["id", "label"],
                          "properties": {
                            "id": { "$ref": "#/$defs/id" },
                            "label": { "type": "string", "minLength": 1 }
                          }
                        }
                      },
                      "correctOptionId": { "$ref": "#/$defs/id" }
                    }
                  }
                },
                "passingScore": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "relation", "rationale"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "relation": {
          "enum": ["requires", "supports", "teaches", "assesses", "contains", "applies-in", "contrasts-with", "alternative-to"]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "publisher", "sourceType", "retrievedAt", "authorityTier", "contentUse", "license"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "publisher": { "type": "string", "minLength": 1 },
        "sourceType": { "enum": ["primary", "official", "scholarly", "open-education", "reference", "community", "repository-authored"] },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "authorityTier": { "enum": ["primary", "high", "contextual", "candidate"] },
        "contentUse": { "enum": ["link-only", "metadata", "excerpt", "redistributable", "repository-authored"] },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "identifier", "attributionRequired", "redistributionAllowed", "derivativesAllowed", "notes"],
          "properties": {
            "status": { "enum": ["verified", "unknown", "restricted", "repository-owned"] },
            "identifier": { "type": "string" },
            "attributionRequired": { "type": "boolean" },
            "redistributionAllowed": { "type": "boolean" },
            "derivativesAllowed": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        }
      }
    }
  }
}
