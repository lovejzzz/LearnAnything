{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnanything.dev/schemas/learning-path.schema.json",
  "title": "LearnAnything Computed Learning Path",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "plannerVersion", "graphId", "graphVersion", "learnerStateId", "goal", "generatedAt", "steps", "horizon", "blockedTargets"],
  "properties": {
    "schemaVersion": { "const": "0.2.0" },
    "id": { "type": "string", "minLength": 1 },
    "plannerVersion": { "type": "string", "minLength": 1 },
    "graphId": { "type": "string", "minLength": 1 },
    "graphVersion": { "type": "string", "minLength": 1 },
    "learnerStateId": { "type": "string", "minLength": 1 },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "targetCapabilityIds", "desiredDepth", "purpose", "hoursPerWeek"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "targetCapabilityIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "desiredDepth": { "enum": ["orientation", "foundation", "working", "advanced"] },
        "purpose": { "type": "string", "minLength": 1 },
        "hoursPerWeek": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityId", "stage", "estimatedHours", "reason", "prerequisiteIds", "resourceIds", "experienceIds", "masteryCheckIds"],
        "properties": {
          "capabilityId": { "type": "string" },
          "stage": { "type": "integer", "minimum": 1 },
          "estimatedHours": { "type": "number", "minimum": 0 },
          "reason": { "type": "string", "minLength": 1 },
          "prerequisiteIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "resourceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "experienceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "masteryCheckIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days", "budgetHours", "capabilityIds", "items"],
      "properties": {
        "days": { "type": "integer", "minimum": 1 },
        "budgetHours": { "type": "number", "exclusiveMinimum": 0 },
        "capabilityIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "capabilityId", "kind", "nodeId", "estimatedHours", "reason", "partial"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "capabilityId": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["learn", "practice", "demonstrate"] },
              "nodeId": { "type": "string", "minLength": 1 },
              "estimatedHours": { "type": "number", "exclusiveMinimum": 0 },
              "reason": { "type": "string", "minLength": 1 },
              "partial": { "type": "boolean" }
            }
          }
        }
      }
    },
    "blockedTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityId", "reason"],
        "properties": {
          "capabilityId": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
